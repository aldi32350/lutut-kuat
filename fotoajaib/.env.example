# ==== App ====
# URL publik (dipakai untuk redirect pembayaran & login Google)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Email admin (pisahkan dengan koma) → otomatis dapat akses /admin
ADMIN_EMAILS=
# Rahasia acak untuk cookie sesi mode demo (isi string panjang acak di produksi)
AUTH_SECRET=
# Kredit gratis akun baru
FREE_CREDITS=3
# Batas generate per user per menit
RATE_LIMIT_PER_MINUTE=5

# ==== AI ====
# gemini | mock | openai | replicate
# Kosong → otomatis "gemini" kalau GEMINI_API_KEY terisi, selain itu "mock" (demo tanpa AI)
AI_PROVIDER=
# Dapatkan di https://aistudio.google.com/apikey (model gambar butuh billing aktif)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Jeda pura-pura provider mock (ms)
MOCK_DELAY_MS=2500

# Nanti (provider tambahan)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# ==== Supabase ====
# Kosong semua → mode demo: akun, data & foto disimpan di folder .data/
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=photos

# ==== Pembayaran ====
# midtrans | xendit | demo. Kosong → otomatis dari key yang terisi, selain itu "demo" (simulasi)
PAYMENT_PROVIDER=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
