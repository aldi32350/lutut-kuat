# ==== AI ====
# Pilih provider: gemini | mock | openai | replicate
# Kosongkan → otomatis "gemini" kalau GEMINI_API_KEY terisi, selain itu "mock" (demo tanpa AI)
AI_PROVIDER=
# Dapatkan di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Nanti (provider tambahan)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=

# ==== Batas pemakaian ====
RATE_LIMIT_PER_MINUTE=5
# Lama jeda pura-pura untuk provider mock (ms)
MOCK_DELAY_MS=2500

# ==== Supabase (Tahap C) ====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ==== Pembayaran (Tahap D) ====
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
